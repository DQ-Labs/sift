{
  "name": "sift",
  "productName": "Sift",
  "version": "0.4.0-alpha.1",
  "description": "Local sample discovery and four-layer song-starter workbench for Windows",
  "appId": "com.dqlabs.sift",
  "author": {
    "name": "DQ Labs",
    "url": "https://github.com/DQ-Labs"
  },
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/DQ-Labs/sift#readme",
  "bugs": {
    "url": "https://github.com/DQ-Labs/sift/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DQ-Labs/sift.git"
  },
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron desktop/main.cjs",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:playback": "node scripts/test-playback.cjs",
    "test:packaged": "node scripts/test-packaged.mjs",
    "check:audio-tools": "node scripts/check-audio-tools.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "icon": "electron scripts/make-icon.cjs",
    "dist:win": "node scripts/fetch-ffmpeg.mjs && electron-builder --win nsis portable --x64 --publish never",
    "pack:win": "node scripts/fetch-ffmpeg.mjs && electron-builder --win --x64 --dir --publish never",
    "release:source": "node scripts/source-archive.mjs",
    "release:checksums": "node scripts/checksums.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "essentia.js": "0.1.3"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.dqlabs.sift",
    "productName": "Sift",
    "copyright": "Copyright © 2026 DQ Labs",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "lib/**/*",
      "public/**/*",
      "server.mjs",
      "package.json",
      "README.md",
      "THIRD_PARTY.md",
      "LICENSE",
      "docs/STUDIO-SETUP.md",
      "docs/RELEASING.md",
      "UPSTREAM-SOURCES.json"
    ],
    "extraResources": [
      {
        "from": "build/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe",
          "LICENSE.txt",
          "README.txt",
          "SOURCE.txt"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Sift-${version}-Setup-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Sift",
      "uninstallDisplayName": "Sift ${version}"
    },
    "portable": {
      "artifactName": "Sift-${version}-Portable-${arch}.${ext}"
    }
  }
}
